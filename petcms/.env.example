# ---- Supabase project settings (https://app.supabase.com -> Project Settings -> API) ----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=pet-images

# ---- Symmetric key used ONLY to encrypt each user's saved AI API key at rest ----
# generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEY_ENCRYPTION_SECRET=change-me-to-a-random-32-byte-secret

# ---- Internal service URLs (defaults match docker-compose network, no need to edit for local use) ----
AUTH_SERVICE_URL=http://auth-service:5001
USER_SERVICE_URL=http://user-service:5002
UPLOAD_SERVICE_URL=http://upload-service:5003
STORAGE_SERVICE_URL=http://storage-service:5004
EXIF_SERVICE_URL=http://exif-service:5005
AI_TAGGING_SERVICE_URL=http://ai-tagging-service:5006
CATEGORY_SERVICE_URL=http://category-service:5007
SEARCH_SERVICE_URL=http://search-service:5008
MEMORY_SERVICE_URL=http://memory-service:5009
CHATBOT_SERVICE_URL=http://chatbot-service:5010
VET_MAP_SERVICE_URL=http://vet-map-service:5011

# ---- Gateway ----
GATEWAY_PORT=8080
